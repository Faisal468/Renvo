# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_TOKEN=change-me-to-a-long-random-string
# Comma-separated list of website origins allowed to call this API
CORS_ORIGIN=https://yourdomain.com
# Folder where content (data.json) and uploaded photos are stored. Keep it OUTSIDE the code folder on the server.
DATA_DIR=/var/renovvo-data
